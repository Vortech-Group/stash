{
    "name": "vortech/laravel-stash",
    "description": "Store and retrieve loose, non-sensitive values in a file, a database or any custom driver.",
    "keywords": [
        "vortech",
        "stash",
        "laravel",
        "storage",
        "key-value"
    ],
    "homepage": "https://github.com/Vortech-Group/stash",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mate Papp",
            "email": "mate@vortech.hu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/config": "^13.0",
        "illuminate/support": "^13.0"
    },
    "suggest": {
        "illuminate/database": "Required to use the database driver (^13.0)."
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Vortech\\Stash\\": "src"
        },
        "files": [
            "src/Supports/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vortech\\Stash\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-html coverage"

    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vortech\\Stash\\Providers\\StashServiceProvider"
            ],
            "aliases": {
                "Stash": "Vortech\\Stash\\Facades\\StashFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
